// Copy to Secrets.xcconfig (gitignored) and fill in from the Google Cloud
// project, APIs & Services > Credentials > your macOS OAuth client.
//
// GID_CLIENT_ID          the client ID, ending in .apps.googleusercontent.com
// GID_REVERSED_CLIENT_ID the same value with the two halves swapped, used as
//                        the OAuth callback URL scheme
//
// Example:
//   GID_CLIENT_ID = 000000000000-abcdefg.apps.googleusercontent.com
//   GID_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-abcdefg

GID_CLIENT_ID =
GID_REVERSED_CLIENT_ID =
